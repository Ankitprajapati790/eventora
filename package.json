{
  "name": "eventora",
  "private": true,
  "version": "1.0.0",
  "description": "Full-stack Eventora event booking platform",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "start": "npm run start --workspace server",
    "build": "npm run build --workspace client",
    "lint": "npm run lint --workspace client",
    "test": "npm test --workspace server",
    "install:all": "npm install",
    "setup": "npm install",
    "dev:all": "npm run dev",
    "start:all": "npm start"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
